;; Native SBCL baseline for benchmarks/mandelbrot.scm.
;; Uses `truncate` to match scheme-bend's signed I24 division exactly.
(declaim (optimize (speed 3) (safety 0) (debug 0)))
(defconstant +n+ 256)
(defconstant +max-iter+ 255)
(defconstant +threshold+ 262144)
(declaim (inline step-re step-im))
(defun step-re (zr zi cr)
  (declare (fixnum zr zi cr))
  (+ (truncate (- (* zr zr) (* zi zi)) 256) cr))
(defun step-im (zr zi ci)
  (declare (fixnum zr zi ci))
  (+ (truncate (* 2 (* zr zi)) 256) ci))
(defun escape (zr zi cr ci n)
  (declare (fixnum zr zi cr ci n))
  (if (= n +max-iter+) +max-iter+
      (if (> (+ (* zr zr) (* zi zi)) +threshold+) n
          (escape (step-re zr zi cr) (step-im zr zi ci) cr ci (1+ n)))))
(defun pixel (p)
  (declare (fixnum p))
  (let ((px (- p (* (truncate p +n+) +n+)))
        (py (truncate p +n+)))
    (escape 0 0 (+ -512 (truncate (* px 768) +n+))
               (+ -320 (truncate (* py 640) +n+)) 0)))
(defun count-range (lo hi)
  (declare (fixnum lo hi))
  (if (= lo hi) (pixel lo)
      (let ((mid (floor (+ lo hi) 2)))
        (+ (count-range lo mid) (count-range (1+ mid) hi)))))
(defun benchmark-result () (logand (count-range 0 (1- (* +n+ +n+))) #xFFFFFF))
(compile 'benchmark-result)
